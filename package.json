{
  "name": "voice-modem",
  "private": true,
  "version": "0.1.0",
  "description": "An acoustic modem in the browser: text and small files over any voice channel.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build crates/modem-wasm --target web --out-dir ../../src/wasm",
    "dev": "npm run wasm && vite",
    "dev:lan": "npm run wasm && vite --host --mode lan",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware --deny-warnings && prettier --check .",
    "format": "prettier --write . && cargo fmt",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check": "npm run check:rust && npm run wasm && npm run typecheck && npm run lint && npm test",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
